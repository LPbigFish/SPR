{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure (debug preset)",
      "type": "shell",
      "command": "cmake --preset debug",
      "problemMatcher": []
    },
    {
      "label": "build (debug preset)",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure (debug preset)"
    }
  ]
}
